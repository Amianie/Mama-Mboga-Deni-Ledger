PORT=3000
# USSD code assigned to you by Africa's Talking
USSD_CODE=*384*1234#
# Public URL of the dashboard (used in SMS links)
PUBLIC_URL=https://your-domain.example
# Africa's Talking credentials. Leave AT_API_KEY empty to print SMS to the console instead.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Long random string; keeps dashboard logins valid across restarts
SESSION_SECRET=change-me
# NODE_ENV=production disables the /simulator page and enables secure cookies (HTTPS)
NODE_ENV=development
